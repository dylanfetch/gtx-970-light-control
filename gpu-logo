#!/usr/bin/env python3
"""gpu-logo: control the WINDFORCE logo LED on a Gigabyte GTX 970 G1 Gaming.

The nouveau driver exposes the logo as a standard kernel LED
(/sys/class/leds/nvidia-logo). This tool drives that LED: fixed brightness,
or one of the kernel's LED triggers for effects. The chosen mode is saved and
re-applied at boot by the udev rule, and an optional schedule dims whatever
mode is showing at night.
"""
import argparse
import contextlib
import errno
import fcntl
import json
import math
import os
import re
import secrets
import shutil
import stat
import subprocess
import sys
import time
import zoneinfo
from datetime import datetime
from pathlib import Path

LED = Path(os.environ.get("GPU_LOGO_LED", "/sys/class/leds/nvidia-logo"))
STATE_DIR = Path(os.environ.get("GPU_LOGO_STATE_DIR", "/var/lib/gpu-logo"))
MODE_FILE = STATE_DIR / "state.json"  # mode to show, restored at boot
SCHEDULE_FILE = STATE_DIR / "schedule.json"  # night dimming, if any
APPLIED_FILE = STATE_DIR / "applied.json"  # what was last written to the LED
CPU_ACTIVE_FILE = STATE_DIR / "cpu.active"  # marker watched by gpu-logo-cpu.path
LOCK_FILE = STATE_DIR / ".lock"  # serializes LED and state updates across writers
GROUP = "plugdev"
# Attributes the udev hook hands to GROUP. The trigger-specific ones only exist
# while their trigger is active.
ATTRS = ("brightness", "trigger", "pattern", "repeat", "delay_on", "delay_off", "invert")

DEFAULT_MODE = {"mode": "static", "level": 100}  # what the card does on its own
GAMMA = 2.2  # PWM duty is linear but perceived brightness is not
DAY_MIN = 24 * 60
TICK_MS = 50  # the kernel's pattern trigger redraws a fade every 50 ms
SYNC_WAIT_S = 5.0  # cap on waiting for a running pattern to reach its resting level
LOCK_WAIT_S = 10.0  # cap on waiting for another writer to release the state lock
MAX_JSON_BYTES = 16 * 1024  # state files are tiny; refuse symlinks, FIFOs and oversized files

# The cpu mode's heartbeat, as (calm, flat out). Tune the feel here.
BEAT_BPM = (20, 60)
BEAT_PEAK = (0.42, 1.0)  # perceived brightness of the main beat
BEAT_BASE_PCT = (3, 8)  # glow between beats, so the logo never goes dark
BEAT_RISE_MS = (150, 100)
BEAT_FALL_MS = (150, 100)
BEAT_SETTLE_MS = (250, 150)
CPU_SAMPLE_S = 2.0
CPU_SMOOTHING = 0.3  # weight of each new sample: settles in roughly ten seconds
CPU_CURVE = 0.75  # lifts the low end a little, so one busy core out of eight already shows
CPU_STEPS = 8  # intervals between calm and flat out (9 distinct levels, 0..8)


class Fail(Exception):
    pass


# --- sysfs -------------------------------------------------------------------

def max_brightness() -> int:
    return int((LED / "max_brightness").read_text())


def to_raw(pct: float, dim: float = 1.0) -> int:
    """Percent of full brightness, scaled by the schedule's dim factor, as a PWM value."""
    raw = round(pct * dim * max_brightness() / 100)
    # Dimming should make a lit logo faint, never round it away to off.
    return max(raw, 1) if pct > 0 and dim > 0 else raw


def write_attr(name: str, value: object, wait: float = 0.0) -> None:
    """Write a sysfs attribute, optionally waiting for it to become writable.

    After a trigger is set the kernel creates its attributes root-only and the
    udev hook regroups them a moment later, hence the wait.
    """
    path = LED / name
    deadline = time.monotonic() + wait
    while True:
        try:
            path.write_text(f"{value}\n")
            return
        except (FileNotFoundError, PermissionError) as e:
            if time.monotonic() >= deadline:
                hint = "" if os.geteuid() == 0 else " (run install.sh, or use sudo)"
                raise Fail(f"cannot write {path}: {e.strerror}{hint}") from e
            time.sleep(0.05)


def read_trigger() -> tuple[str, list[str]]:
    """Return (active trigger, all available triggers)."""
    names = (LED / "trigger").read_text().split()
    active = next((n[1:-1] for n in names if n.startswith("[")), "none")
    return active, [n.strip("[]") for n in names]


def ensure_trigger(name: str, module: str | None = None) -> None:
    """Verify `name` is available, loading `module` when running as root."""
    _, available = read_trigger()
    if name in available:
        return
    if module:
        if os.geteuid() == 0:
            subprocess.run(["modprobe", "-q", module], check=False)
            _, available = read_trigger()
            if name in available:
                return
        else:
            raise Fail(f"LED trigger '{name}' is not loaded; run: sudo modprobe {module}")
    raise Fail(f"LED trigger '{name}' is not available on {LED}")


def set_trigger(name: str, module: str | None = None) -> None:
    ensure_trigger(name, module)
    write_attr("trigger", name)


def wait_for_pattern_rest(still_wanted=lambda: True) -> None:
    """Wait for a running pattern to return to its resting level (capped at SYNC_WAIT_S).

    Writing a pattern restarts it from its first tuple. Every pattern here
    starts at its resting level, so waiting for the running one to get back
    there avoids a visible jump.
    """
    try:
        resting = int((LED / "pattern").read_text().split()[0])
    except (OSError, ValueError, IndexError):
        return  # nothing running yet
    deadline = time.monotonic() + SYNC_WAIT_S
    while time.monotonic() < deadline and still_wanted():
        try:
            # The driver reads the PWM register back and can return one count less.
            if resting - 1 <= int((LED / "brightness").read_text()) <= resting:
                return
        except (OSError, ValueError):
            return
        time.sleep(0.02)


def write_pattern(pattern: str, still_wanted=lambda: True, wait_rest: bool = True) -> None:
    """Start a pattern, optionally waiting for a running one to reach its resting level."""
    if wait_rest:
        wait_for_pattern_rest(still_wanted)
    if still_wanted():
        write_attr("pattern", pattern, wait=3.0)


# --- patterns ----------------------------------------------------------------
# A pattern is '<level> <ms>' tuples; the kernel fades from each level to the
# next and wraps around at the end.

def step_tuple(level: int, next_level: int, ms: int) -> str:
    """Format one tuple lasting `ms` ms (a multiple of 50, at least 100).

    Linux's ledtrig-pattern spends one extra 50 ms redraw when fading to a
    different level, and none when holding the same level.
    """
    return f"{level} {ms - TICK_MS if level != next_level else ms}"


def whole_ticks(ms: float) -> int:
    return max(round(ms / TICK_MS), 2) * TICK_MS


def breathe_pattern(period_ms: int, lo: int, hi: int) -> str:
    """Gamma-eased ramp lo -> hi -> lo."""
    steps = min(max(round(period_ms / 200), 1), 40)  # per half cycle; 100 ms each where possible
    step_ms = whole_ticks(period_ms / (2 * steps))
    up = [round(lo + (hi - lo) * (i / steps) ** GAMMA) for i in range(steps + 1)]
    points = up[:-1] + up[:0:-1]  # rise, then fall; the repeat wraps back to up[0]
    n = len(points)
    return " ".join(step_tuple(points[i], points[(i + 1) % n], step_ms) for i in range(n))


def heartbeat_pattern(effort: float, dim: float = 1.0) -> str | None:
    """A lub-dub whose pace and strength follow `effort` (0 calm .. 1 flat out).

    Returns None when dimming leaves no room for a beat.
    """
    def between(pair: tuple[float, float]) -> float:
        return pair[0] + (pair[1] - pair[0]) * effort

    base = to_raw(between(BEAT_BASE_PCT), dim)
    peak = to_raw(100 * between(BEAT_PEAK) ** GAMMA, dim)
    if peak <= base:
        return None
    dip = base + round((peak - base) * 0.3)  # between the two beats
    dub = base + round((peak - base) * 0.6)  # the second, weaker beat
    rise, fall, settle = (whole_ticks(between(p)) for p in (BEAT_RISE_MS, BEAT_FALL_MS, BEAT_SETTLE_MS))
    rest = max(whole_ticks(60000 / between(BEAT_BPM)) - (2 * rise + fall + settle), 2 * TICK_MS)
    tuples = [(base, rise), (peak, fall), (dip, rise), (dub, settle), (base, rest)]
    n = len(tuples)
    return " ".join(step_tuple(lvl, tuples[(i + 1) % n][0], ms) for i, (lvl, ms) in enumerate(tuples))


# --- modes -------------------------------------------------------------------

def _int(raw: dict, key: str, default: int | None, lo: int, hi: int) -> int:
    v = raw.get(key, default)
    if isinstance(v, bool) or not isinstance(v, int) or not lo <= v <= hi:
        raise Fail(f"{key} must be an integer from {lo} to {hi}")
    return v


def normalize(raw: object) -> dict:
    """Validate a mode description (from the command line or a saved file).

    The saved files are group-writable and are applied as root, so nothing from
    them reaches sysfs without passing through here.
    """
    if not isinstance(raw, dict):
        raise Fail("mode must be a JSON object")
    mode = raw.get("mode")
    if mode == "static":
        return {"mode": mode, "level": _int(raw, "level", 100, 0, 100)}
    if mode == "breathe":
        s = {"mode": mode, "period_ms": _int(raw, "period_ms", 4000, 200, 600000),
             "min": _int(raw, "min", 0, 0, 100), "max": _int(raw, "max", 100, 0, 100)}
        if s["min"] >= s["max"]:
            raise Fail("min must be lower than max")
        return s
    if mode == "blink":
        return {"mode": mode, "on_ms": _int(raw, "on_ms", 500, 10, 600000),
                "off_ms": _int(raw, "off_ms", 500, 10, 600000), "level": _int(raw, "level", 100, 1, 100)}
    if mode in ("cpu", "disk"):
        return {"mode": mode}
    raise Fail(f"unknown mode: {mode!r}")


def apply(state: dict, dim: float = 1.0, wait_rest: bool = True) -> None:
    """Show `state` on the LED, with every brightness scaled by `dim` (0..1)."""
    mode = state["mode"]

    pattern = None
    if mode == "breathe":
        lo, hi = to_raw(state["min"], dim), to_raw(state["max"], dim)
        pattern = breathe_pattern(state["period_ms"], lo, hi) if lo < hi else None
    elif mode == "cpu":
        # The calm beat; the cpu daemon takes over from here and follows the load.
        pattern = heartbeat_pattern(0.0, dim)
    if pattern:
        if read_trigger()[0] != "pattern":
            ensure_trigger("pattern", "ledtrig-pattern")
            write_attr("trigger", "none")
            set_trigger("pattern", "ledtrig-pattern")
        write_pattern(pattern, wait_rest=wait_rest)
        return

    if mode in ("breathe", "cpu"):  # dimmed so far that there is no swing left
        level = to_raw(state["max"] if mode == "breathe" else 100 * BEAT_PEAK[0] ** GAMMA, dim)
    else:
        level = to_raw(state.get("level", 100), dim)

    # Check trigger availability before clearing whatever effect is currently showing.
    if level > 0:
        if mode == "blink":
            ensure_trigger("timer", "ledtrig-timer")
        elif mode == "disk":
            ensure_trigger("disk-activity")

    # Drop the old trigger first: writing brightness 0 under an active trigger
    # would remove it anyway, and this gives every mode a clean start.
    write_attr("trigger", "none")
    write_attr("brightness", level)
    if level == 0:
        return
    if mode == "blink":
        # The timer trigger blinks at whatever brightness was set when it started.
        set_trigger("timer", "ledtrig-timer")
        write_attr("delay_on", state["on_ms"], wait=3.0)
        write_attr("delay_off", state["off_ms"], wait=3.0)
    elif mode == "disk":
        set_trigger("disk-activity")
        # This trigger flashes at the LED's remembered blink brightness, left
        # over from whatever ran before. Writing brightness sets that level.
        write_attr("brightness", level)


# --- schedule ----------------------------------------------------------------

def normalize_schedule(raw: object) -> dict:
    if not isinstance(raw, dict):
        raise Fail("schedule must be a JSON object")
    s = {key: _int(raw, key, None, 0, DAY_MIN - 1)
         for key in ("dim_start", "dim_end", "bright_start", "bright_end")}
    s["level"] = _int(raw, "level", None, 0, 100)
    # Minutes after dimming starts at which each later point falls. They must
    # come in order within one day: dimmed, then brightening, then bright.
    dimmed, brightening, bright = ((s[key] - s["dim_start"]) % DAY_MIN
                                   for key in ("dim_end", "bright_start", "bright_end"))
    if brightening < dimmed:
        raise Fail("brightening starts before dimming has finished")
    if bright < brightening:
        raise Fail("dimming and brightening together take more than a day")
    if bright == 0:
        raise Fail("the schedule leaves no time dimmed")
    tz = raw.get("tz")
    if tz is not None:
        if not isinstance(tz, str) or tz not in zoneinfo.available_timezones():
            raise Fail(f"unknown timezone {tz!r}; use a name like America/New_York")
        s["tz"] = tz
    return s


def dim_at(s: dict, minute: float) -> float:
    """Brightness factor (0..1) the schedule calls for at local wall-clock `minute`.

    Both fades follow a gamma curve so they look even to the eye. Evaluated on
    wall-clock HH:MM, so fades crossing a DST transition repeat or skip the
    shifted hour.
    """
    def ease(a: float, b: float, f: float) -> float:
        ga, gb = a ** (1 / GAMMA), b ** (1 / GAMMA)
        return (ga + (gb - ga) * f) ** GAMMA

    dimmed, brightening, bright = ((s[key] - s["dim_start"]) % DAY_MIN
                                   for key in ("dim_end", "bright_start", "bright_end"))
    t = (minute - s["dim_start"]) % DAY_MIN  # minutes since dimming began
    night = s["level"] / 100
    if t < dimmed:
        return ease(1.0, night, t / dimmed)
    if t < brightening:
        return night
    if t < bright:
        return ease(night, 1.0, (t - brightening) / (bright - brightening))
    return 1.0


def schedule_now(schedule: dict) -> datetime:
    """The current time on the clock the schedule is written for."""
    tz = schedule.get("tz")
    return datetime.now(zoneinfo.ZoneInfo(tz)) if tz else datetime.now().astimezone()


def current_dim(schedule: dict | None, now: datetime | None = None) -> float:
    if not schedule:
        return 1.0
    now = schedule_now(schedule) if now is None else now
    return round(dim_at(schedule, now.hour * 60 + now.minute + now.second / 60), 3)


def parse_clock(text: str) -> int:
    m = re.fullmatch(r"([01]?\d|2[0-3]):([0-5]\d)", text)
    if not m:
        raise Fail(f"'{text}' is not a 24-hour time like 22:30")
    return int(m[1]) * 60 + int(m[2])


def parse_span(text: str) -> tuple[int, int]:
    """'23:30-02:00' is a fade from one time to the other; a lone '02:00' switches at once."""
    start, sep, end = text.partition("-")
    return parse_clock(start), parse_clock(end if sep else start)


def clock(minutes: int) -> str:
    return f"{minutes // 60:02d}:{minutes % 60:02d}"


def describe_schedule(s: dict | None) -> str:
    if not s:
        return "none"

    def span(start: int, end: int) -> str:
        return f"at {clock(start)}" if start == end else f"from {clock(start)} to {clock(end)}"

    # Spell out which clock is in use: the system's may not be the one on the wall.
    now = schedule_now(s)
    return (f"dim to {s['level']}% {span(s['dim_start'], s['dim_end'])}, "
            f"brighten {span(s['bright_start'], s['bright_end'])} "
            f"(now {now:%H:%M} {s.get('tz') or now.tzname()}, at {round(current_dim(s, now) * 100)}%)")


# --- saved files and locking -------------------------------------------------

@contextlib.contextmanager
def state_lock(timeout: float = LOCK_WAIT_S):
    """Serialize LED and state-file updates across the CLI, timer, udev and daemon."""
    if not STATE_DIR.is_dir():
        yield
        return
    deadline = time.monotonic() + timeout
    fd = -1
    try:
        while True:
            try:
                fd = os.open(LOCK_FILE, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK, 0o664)
            except PermissionError:
                # On Linux flock(2) works on a read-only descriptor if the lock file already exists.
                try:
                    fd = os.open(LOCK_FILE, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
                except OSError as e:
                    if e.errno in (errno.ENOENT, errno.EACCES, errno.EROFS):
                        yield  # uninstalled / read-only state dir
                        return
                    if e.errno == errno.ELOOP:
                        raise Fail(f"{LOCK_FILE} must be a regular file, not a symlink") from e
                    raise
            except OSError as e:
                if e.errno == errno.ELOOP:
                    raise Fail(f"{LOCK_FILE} must be a regular file, not a symlink") from e
                if e.errno in (errno.EACCES, errno.EROFS):
                    yield
                    return
                raise
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode):
                raise Fail(f"{LOCK_FILE} must be a regular file")
            if st.st_uid == os.geteuid() and (st.st_mode & 0o777) != 0o664:
                os.fchmod(fd, 0o664)
            while True:
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    if time.monotonic() >= deadline:
                        raise Fail(f"timed out waiting for lock {LOCK_FILE}")
                    time.sleep(0.02)
            # Re-check that the lock file wasn't unlinked or swapped while we waited.
            try:
                pst = os.lstat(LOCK_FILE)
                if (pst.st_dev, pst.st_ino) == (st.st_dev, st.st_ino):
                    break
            except FileNotFoundError:
                pass
            os.close(fd)
            fd = -1
        yield
    finally:
        if fd >= 0:
            try:
                fcntl.flock(fd, fcntl.LOCK_UN)
            finally:
                os.close(fd)


def read_json(path: Path) -> object | None:
    """Read a small regular JSON file without following symlinks or blocking on FIFOs."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return None
    except OSError as e:
        if e.errno == errno.ELOOP:
            raise Fail(f"{path} must be a regular file, not a symlink") from e
        raise Fail(f"cannot read {path}: {e.strerror}") from e
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise Fail(f"{path} must be a regular file")
        if st.st_size > MAX_JSON_BYTES:
            raise Fail(f"{path} is too large")
        with os.fdopen(fd, "rb") as f:
            fd = -1
            raw = f.read(MAX_JSON_BYTES + 1)
    finally:
        if fd >= 0:
            os.close(fd)
    if len(raw) > MAX_JSON_BYTES:
        raise Fail(f"{path} is too large")
    try:
        return json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, ValueError) as e:
        raise Fail(f"{path} is not valid JSON") from e


def _open_stage_dir(parent_fd: int, parent: Path) -> tuple[int, bool]:
    """Return (dir_fd, should_close) for staging atomic writes.

    When running as root, stage inside a root-only subdirectory so group
    members cannot unlink or swap the temp file before rename.
    """
    if os.geteuid() != 0:
        return parent_fd, False
    stage_name = ".root-tmp"
    try:
        os.mkdir(stage_name, 0o700, dir_fd=parent_fd)
    except FileExistsError:
        pass
    try:
        stage_fd = os.open(stage_name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent_fd)
    except OSError as e:
        raise Fail(f"unsafe staging directory {parent / stage_name}: {e.strerror}") from e
    try:
        st = os.fstat(stage_fd)
        if st.st_uid != 0 or (st.st_mode & 0o077):
            raise Fail(f"unsafe staging directory: {parent / stage_name}")
    except BaseException:
        os.close(stage_fd)
        raise
    return stage_fd, True


def _atomic_write(path: Path, payload: bytes) -> None:
    """Atomically replace `path` with `payload`, applying permissions on the open fd."""
    # Replace rather than overwrite: root and the user both write these, and a
    # rename only needs the directory to be writable, whoever owns the old file.
    parent_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    stage_fd = -1
    close_stage = False
    try:
        stage_fd, close_stage = _open_stage_dir(parent_fd, path.parent)
        while True:
            tmp_name = f".{path.name}.{secrets.token_hex(8)}"
            try:
                fd = os.open(tmp_name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=stage_fd)
                break
            except FileExistsError:
                continue
        try:
            with os.fdopen(fd, "wb") as f:
                fd = -1
                f.write(payload)
                f.flush()
                if stage_fd != parent_fd:
                    os.fchown(f.fileno(), -1, os.fstat(parent_fd).st_gid)
                os.fchmod(f.fileno(), 0o664)
            os.replace(tmp_name, path.name, src_dir_fd=stage_fd, dst_dir_fd=parent_fd)
        except BaseException:
            if fd >= 0:
                os.close(fd)
            try:
                os.unlink(tmp_name, dir_fd=stage_fd)
            except OSError:
                pass
            raise
    finally:
        if close_stage and stage_fd >= 0:
            os.close(stage_fd)
        os.close(parent_fd)


def write_json(path: Path, data: object) -> None:
    _atomic_write(path, (json.dumps(data) + "\n").encode("utf-8"))


def sync_cpu_flag(active: bool) -> None:
    """Maintain the level-triggered marker file watched by gpu-logo-cpu.path."""
    try:
        if active:
            try:
                if stat.S_ISREG(os.lstat(CPU_ACTIVE_FILE).st_mode):
                    return
            except FileNotFoundError:
                pass
            _atomic_write(CPU_ACTIVE_FILE, b"")
        else:
            CPU_ACTIVE_FILE.unlink(missing_ok=True)
    except OSError:
        pass  # not installed


def load_mode() -> dict | None:
    raw = read_json(MODE_FILE)
    try:
        return None if raw is None else normalize(raw)
    except Fail as e:
        raise Fail(f"invalid {MODE_FILE}: {e}") from e


def load_schedule() -> dict | None:
    raw = read_json(SCHEDULE_FILE)
    try:
        return None if raw is None else normalize_schedule(raw)
    except Fail as e:
        raise Fail(f"invalid {SCHEDULE_FILE}: {e}") from e


def boot_id() -> str:
    return Path("/proc/sys/kernel/random/boot_id").read_text().strip()


def load_applied() -> tuple[dict, float] | None:
    """The mode and dim factor last written to the LED, if known for this boot."""
    try:
        raw = read_json(APPLIED_FILE)
        # The LED resets when the machine restarts, so an older record is void.
        if not isinstance(raw, dict) or raw.get("boot") != boot_id():
            return None
        dim = raw.get("dim")
        if isinstance(dim, bool) or not isinstance(dim, (int, float)):
            return None
        dim_f = float(dim)
        if not math.isfinite(dim_f) or not 0.0 <= dim_f <= 1.0:
            return None
        return normalize(raw.get("state")), dim_f
    except Fail:
        return None


def _applied_stamp() -> tuple[int, int] | None:
    try:
        st = os.lstat(APPLIED_FILE)
        return st.st_mtime_ns, st.st_ino
    except FileNotFoundError:
        return None


def record_applied(state: dict, dim: float) -> None:
    try:
        write_json(APPLIED_FILE, {"boot": boot_id(), "state": state, "dim": dim})
    except OSError:
        pass  # not installed; only costs the schedule its memory of what is showing


def _show_locked(state: dict, dim: float, wait_rest: bool = True) -> None:
    apply(state, dim, wait_rest=wait_rest)
    record_applied(state, dim)
    sync_cpu_flag(state["mode"] == "cpu")


def show(state: dict, dim: float) -> None:
    with state_lock():
        _show_locked(state, dim)


def showing() -> dict:
    """The mode currently on the LED, as far as we know."""
    applied = load_applied()
    return applied[0] if applied else load_mode() or DEFAULT_MODE


# --- cpu heartbeat -----------------------------------------------------------

def cpu_times() -> tuple[int, int]:
    """(busy, total) CPU time since boot, summed over every core."""
    fields = [int(x) for x in Path("/proc/stat").read_text().split("\n", 1)[0].split()[1:9]]
    return sum(fields) - fields[3] - fields[4], sum(fields)  # idle and iowait are not busy


def next_step(effort: float, current: int | None) -> int:
    """Quantize effort (0..1) to a heart rate step, holding the current one near a boundary."""
    exact = effort * CPU_STEPS
    return current if current is not None and abs(exact - current) <= 0.75 else round(exact)


def _cpu_daemon_step(seen: tuple[int, int] | None, step: int | None, dim: float,
                     wanted: int) -> tuple[bool, int | None, bool]:
    """Apply one heartbeat step if `cpu` mode is still active.

    Returns (keep_running, new_step, stamp_changed).
    """
    pattern = heartbeat_pattern(wanted / CPU_STEPS, dim)
    if pattern and read_trigger()[0] == "pattern":
        wait_for_pattern_rest(still_wanted=lambda: _applied_stamp() == seen)
    with state_lock():
        if _applied_stamp() != seen:
            return True, step, True
        applied = load_applied()
        if not applied or applied[0]["mode"] != "cpu":
            sync_cpu_flag(False)
            return False, step, False
        dim = applied[1]
        pattern = heartbeat_pattern(wanted / CPU_STEPS, dim)
        if pattern:
            if read_trigger()[0] != "pattern":
                ensure_trigger("pattern", "ledtrig-pattern")
                write_attr("trigger", "none")
                set_trigger("pattern", "ledtrig-pattern")
            write_attr("pattern", pattern, wait=3.0)
        else:
            level = to_raw(100 * BEAT_PEAK[0] ** GAMMA, dim)
            if read_trigger()[0] != "none" or int((LED / "brightness").read_text()) != level:
                apply({"mode": "cpu"}, dim, wait_rest=False)
        return True, wanted, False


def cpu_daemon() -> None:
    """Keep the cpu mode's heartbeat in step with CPU load.

    systemd starts this at boot and whenever cpu.active exists. It returns at
    once unless cpu mode is showing, and returns when another mode replaces it,
    so nothing lingers for the other modes.
    """
    if not LED.exists():
        # Clear any leftover flag from a previous boot so the path unit does not
        # spin; udev-hook recreates it when the LED appears and restores cpu mode.
        with state_lock():
            sync_cpu_flag(False)
        return
    with state_lock():
        if load_applied() is None:  # nothing has drawn on the LED this boot
            state = load_mode() or DEFAULT_MODE
            if state["mode"] != "cpu":
                sync_cpu_flag(False)
                return
            _show_locked(state, current_dim(load_schedule()))

    seen = step = smooth = None
    dim = 1.0
    busy_before, total_before = cpu_times()
    while True:
        with state_lock():
            current = _applied_stamp()
            if current != seen:
                seen = current
                applied = load_applied()
                if not applied or applied[0]["mode"] != "cpu":
                    sync_cpu_flag(False)
                    return
                # The LED was redrawn at the calm beat, or the dimming changed.
                dim, step = applied[1], None
        busy, total = cpu_times()
        if total > total_before:  # false only on the first pass
            load = (busy - busy_before) / (total - total_before)
            busy_before, total_before = busy, total
            smooth = load if smooth is None else smooth + CPU_SMOOTHING * (load - smooth)
            wanted = next_step(min(smooth, 1.0) ** CPU_CURVE, step)
            if wanted != step:
                keep_running, step, changed = _cpu_daemon_step(seen, step, dim, wanted)
                if not keep_running:
                    return
                if changed:
                    continue
        # Sleep last, so a mode change is always noticed before the next write.
        time.sleep(CPU_SAMPLE_S)


# --- commands ----------------------------------------------------------------

def udev_hook() -> None:
    """Run as root by the udev rule on add/change events for the LED."""
    for attr in ATTRS:
        path = LED / attr
        try:
            shutil.chown(path, group=GROUP)
            path.chmod(0o664)
        except FileNotFoundError:
            continue  # trigger attributes can disappear if the trigger changes concurrently
    # Only on "add": applying a mode sets a trigger, which emits a "change"
    # event, and restoring on that too would loop.
    if os.environ.get("ACTION") == "add":
        with state_lock(timeout=2.0):
            mode, schedule = load_mode(), load_schedule()
            if mode or schedule:
                _show_locked(mode or DEFAULT_MODE, current_dim(schedule))


def tick() -> None:
    """Run every minute by the systemd timer: follow the schedule."""
    # If a breathing pattern needs dimming, wait for its resting level before
    # taking the lock so CLI commands do not stall behind a multi-second wait.
    pre_schedule = load_schedule()
    if not pre_schedule:
        return
    pre_dim = current_dim(pre_schedule)
    pre_applied = load_applied()
    if pre_applied and pre_applied[1] == pre_dim:
        return
    pre_state = pre_applied[0] if pre_applied else load_mode() or DEFAULT_MODE
    if pre_state["mode"] == "breathe" and read_trigger()[0] == "pattern":
        before = _applied_stamp()
        wait_for_pattern_rest(still_wanted=lambda: _applied_stamp() == before)

    with state_lock():
        schedule = load_schedule()
        if not schedule:
            return
        dim = current_dim(schedule)
        applied = load_applied()
        # Re-applying would restart a running effect, so only act on a change.
        if applied and applied[1] == dim:
            return
        state = applied[0] if applied else load_mode() or DEFAULT_MODE
        if (state["mode"] == "cpu" and read_trigger()[0] == "pattern"
                and heartbeat_pattern(0.0, dim) is not None):
            # The cpu daemon watches this record and redraws at the new level;
            # applying here would drop the heartbeat back to calm first.
            record_applied(state, dim)
            sync_cpu_flag(True)
        else:
            _show_locked(state, dim, wait_rest=False)


def schedule_command(a: argparse.Namespace) -> None:
    if a.off:
        with state_lock():
            SCHEDULE_FILE.unlink(missing_ok=True)
            _show_locked(showing(), 1.0)
        print("schedule: none")
        return
    if a.dim is None and a.brighten is None:
        print(f"schedule: {describe_schedule(load_schedule())}")
        return
    if a.dim is None or a.brighten is None:
        raise Fail("give both --dim and --brighten")
    (dim_start, dim_end), (bright_start, bright_end) = parse_span(a.dim), parse_span(a.brighten)
    schedule = normalize_schedule({"dim_start": dim_start, "dim_end": dim_end, "bright_start": bright_start,
                                   "bright_end": bright_end, "level": a.level, "tz": a.tz})
    with state_lock():
        try:
            write_json(SCHEDULE_FILE, schedule)
        except OSError as e:
            raise Fail(f"cannot save {SCHEDULE_FILE}: {e.strerror} (run install.sh)") from e
        _show_locked(showing(), current_dim(schedule))
    print(f"schedule: {describe_schedule(schedule)}")


def status() -> None:
    def safe(load, render):
        try:
            return render(load())
        except Fail as e:
            return str(e)

    active, _ = read_trigger()
    raw = int((LED / "brightness").read_text())
    print(f"led:        {LED}")
    print(f"trigger:    {active}")
    print(f"brightness: {raw}/{max_brightness()} ({round(raw * 100 / max_brightness())}%)")
    print(f"showing:    {json.dumps(showing()) if load_applied() else 'unknown (not set by gpu-logo since boot)'}")
    print(f"saved mode: {safe(load_mode, lambda m: json.dumps(m) if m else 'none (card default: full brightness)')}")
    print(f"schedule:   {safe(load_schedule, describe_schedule)}")


def main() -> None:
    p = argparse.ArgumentParser(prog="gpu-logo", description="Control the GPU's WINDFORCE logo LED.")
    p.add_argument("--no-save", action="store_true", help="do not remember this mode for the next boot")
    sub = p.add_subparsers(dest="cmd", required=True, metavar="command")
    sub.add_parser("status", help="show current and saved state")
    sub.add_parser("on", help="full brightness")
    sub.add_parser("off", help="turn the logo off")
    s = sub.add_parser("set", help="fixed brightness")
    s.add_argument("level", type=int, metavar="PERCENT", help="0-100")
    s = sub.add_parser("breathe", help="fade in and out")
    s.add_argument("--period", type=float, default=4.0, metavar="SEC", help="seconds per cycle (default 4)")
    s.add_argument("--min", type=int, default=0, metavar="PERCENT")
    s.add_argument("--max", type=int, default=100, metavar="PERCENT")
    s = sub.add_parser("blink", help="flash on and off")
    s.add_argument("--on", type=int, default=500, metavar="MS", dest="on_ms")
    s.add_argument("--off", type=int, default=500, metavar="MS", dest="off_ms")
    s.add_argument("--level", type=int, default=100, metavar="PERCENT")
    sub.add_parser("cpu", help="heartbeat that follows CPU load")
    sub.add_parser("disk", help="flicker on disk activity")
    s = sub.add_parser(
        "schedule", help="dim at night (no arguments: show the schedule)",
        description="Dim whatever mode is showing overnight. Times are 24-hour, on the system clock "
                    "unless --tz is given. 'HH:MM-HH:MM' fades gradually from the first time to the "
                    "second; a single 'HH:MM' switches at once. With no arguments, show the schedule.")
    s.add_argument("--dim", metavar="HH:MM[-HH:MM]", help="when to dim, e.g. 23:30-02:00")
    s.add_argument("--brighten", metavar="HH:MM[-HH:MM]", help="when to return to normal, e.g. 08:30-09:00")
    s.add_argument("--level", type=int, default=10, metavar="PERCENT",
                   help="brightness while dimmed, as a percent of normal (default 10; 0 is off)")
    s.add_argument("--tz", metavar="ZONE",
                   help="timezone the times are in, e.g. America/New_York (default: the system's)")
    s.add_argument("--off", action="store_true", help="remove the schedule")
    sub.add_parser("restore", help="re-apply the saved mode")
    # Internal, run by udev and systemd; no help= keeps them out of --help.
    sub.add_parser("udev-hook")
    sub.add_parser("tick")
    sub.add_parser("cpu-daemon")
    a = p.parse_args()

    try:
        if a.cmd == "cpu-daemon":
            try:
                return cpu_daemon()
            except Fail:
                sync_cpu_flag(False)
                raise
        if not LED.exists():
            raise Fail(f"{LED} not found: is the card running on the nouveau driver?")
        if a.cmd == "status":
            return status()
        if a.cmd == "udev-hook":
            return udev_hook()
        if a.cmd == "tick":
            return tick()
        if a.cmd == "schedule":
            return schedule_command(a)
        if a.cmd == "restore":
            with state_lock():
                state = load_mode()
                if not state:
                    raise Fail("no saved mode")
                return _show_locked(state, current_dim(load_schedule()))

        if a.cmd in ("on", "off"):
            raw = {"mode": "static", "level": 100 if a.cmd == "on" else 0}
        elif a.cmd == "set":
            raw = {"mode": "static", "level": a.level}
        elif a.cmd == "breathe":
            if not math.isfinite(a.period):
                raise Fail("period must be a finite number")
            raw = {"mode": "breathe", "period_ms": round(a.period * 1000), "min": a.min, "max": a.max}
        elif a.cmd == "blink":
            raw = {"mode": "blink", "on_ms": a.on_ms, "off_ms": a.off_ms, "level": a.level}
        else:
            raw = {"mode": a.cmd}
        state = normalize(raw)
        with state_lock():
            _show_locked(state, current_dim(load_schedule()))
            if not a.no_save:
                try:
                    write_json(MODE_FILE, state)
                except OSError as e:
                    print(f"note: applied, but could not save for next boot ({MODE_FILE}: {e.strerror})",
                          file=sys.stderr)
    except Fail as e:
        sys.exit(f"gpu-logo: {e}")


if __name__ == "__main__":
    main()
