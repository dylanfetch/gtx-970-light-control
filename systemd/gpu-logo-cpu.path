[Unit]
Description=Start the gpu-logo CPU heartbeat when CPU mode is selected

[Path]
# Watches a pre-created regular file under root-owned /var/lib/gpu-logo so
# group members cannot replace it with a directory or trigger spurious starts
# from temporary files.
PathModified=/var/lib/gpu-logo/cpu.wake
Unit=gpu-logo-cpu.service

[Install]
WantedBy=paths.target
