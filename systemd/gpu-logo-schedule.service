[Unit]
Description=Follow the gpu-logo dimming schedule
# Nothing to do, and nothing worth logging, until a schedule has been set.
ConditionPathExists=/var/lib/gpu-logo/state/schedule.json

[Service]
Type=oneshot
ExecStart=/usr/local/bin/gpu-logo tick
# This runs every minute; keep its routine start/stop lines out of the journal.
LogLevelMax=notice
