[Unit]
Description=Drive the gpu-logo CPU heartbeat
# Started at boot and while cpu.active exists (see the .path unit).
# Allow rapid manual switches while still preventing a runaway crash loop.
StartLimitIntervalSec=10s
StartLimitBurst=15

[Service]
ExecStart=/usr/local/bin/gpu-logo cpu-daemon
LogLevelMax=notice

[Install]
WantedBy=multi-user.target
